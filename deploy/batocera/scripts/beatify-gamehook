#!/bin/bash
# EmulationStation game hook: stop Beatify when an emulator starts.
#
# Batocera calls every script in /userdata/system/scripts/ with:
#   $1  gameStart | gameStop     $2 system   $3 emulator   $4 core   $5 rom
#
# Deliberately one-directional: a game stops Beatify, and nothing starts it
# again except a reboot. Restoring it on gameStop was possible but not worth the
# state it needed — Beatify comes back on the next boot anyway, and "reboot to
# play Beatify" is one rule instead of a behaviour you have to remember.
#
# Note this is not about resources. Measured on a Pi 4B/8GB, Beatify idles at
# ~74 MB and go-librespot at ~21 MB — 1.2 % of memory, roughly a second of CPU
# per minute. It is about the audio device: with librespot_device set to a card
# directly (plughw:CARD=Headphones) the Connect daemon holds it open and an
# emulator can come up silent.

LOG=/userdata/system/logs/beatify-gamehook.log

if [ "$1" = "gameStart" ]; then
    if pgrep -f beatify-standalone >/dev/null 2>&1; then
        echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') gameStart ($2/$3) — stopping beatify" >> "$LOG" 2>/dev/null
        batocera-services stop beatify >/dev/null 2>&1
    fi
fi

exit 0
